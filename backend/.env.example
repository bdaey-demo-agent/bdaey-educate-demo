# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Database=bdaey_db;Username=postgres;Password=your_password

# JWT Authentication
Jwt__Key=YourSuperSecretKeyHere_AtLeast32BytesLong!
Jwt__Issuer=BdaeyEducat
Jwt__Audience=BdaeyEducat
Jwt__ExpireDays=30

# Admin Account Seeding
Admin__Email=admin@bdaey.com
Admin__Password=Admin@123456

# SMTP Email Settings
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__EnableSsl=true
SmtpSettings__Email=your_email@gmail.com
SmtpSettings__Password=your_email_app_password

# Daily.co Video Calling
Video__Provider=daily
Daily__Domain=your-daily-domain.daily.co
DAILY_API_KEY=your_daily_api_key

# AWS S3 Storage (Optional)
AWS__AccessKey=your_aws_access_key
AWS__SecretKey=your_aws_secret_key
AWS__Region=us-east-1
AWS__BucketName=your_bucket_name

# Kashier Payment Gateway (Optional)
Kashier__MerchantId=your_merchant_id
Kashier__ApiKey=your_api_key
Kashier__SecretKey=your_secret_key

# Redis Cache (Optional)
Redis__Configuration=localhost:6379
