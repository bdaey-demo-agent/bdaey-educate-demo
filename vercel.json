{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix quran-front ci --include=dev",
  "buildCommand": "npm --prefix quran-front run build",
  "outputDirectory": "quran-front/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
